{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quorum",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quorum",
      "database_id": "387c1cb5-1633-4934-945c-bd05680c2902"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "quorum.tenyearmc.top/*",
      "zone_name": "tenyearmc.top"
    }
  ]
}
