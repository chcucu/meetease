generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  activities   Activity[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Activity {
  id               String   @id @default(cuid())
  shareCode        String   @unique
  joinCode         String?  @unique
  ownerId          String
  title            String
  description      String   @default("")
  category         String   @default("other")
  status           String   @default("open") // open | closed
  voteType         String   @default("single") // single | multiple
  allowSuggestions Boolean  @default(true)
  deadline         DateTime?
  tieBreakOptionIds String? // JSON array of option ids in the current runoff
  tieBreakUntil    DateTime?
  coverTheme       String   @default("lime")
  coverImage       String?
  timeZone         String   @default("Asia/Shanghai")
  locationName     String?
  locationAddress  String?
  locationLat      Float?
  locationLng      Float?
  feeAmount        Float?
  feeNote          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  options      PollOption[]
  fields       CustomField[]
  suggestions  Suggestion[]
  participants Participant[]

  @@index([ownerId, createdAt])
}

model PollOption {
  id         String    @id @default(cuid())
  activityId String
  kind       String // time | place
  label      String
  note       String?
  startsAt   DateTime?
  endsAt     DateTime?
  lat        Float?
  lng        Float?
  sortOrder  Int       @default(0)
  activity   Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  votes      Vote[]

  @@index([activityId, kind])
}

model CustomField {
  id          String   @id @default(cuid())
  activityId  String
  label       String
  type        String   @default("text") // text | textarea | number | select | multi
  required    Boolean  @default(false)
  options     String? // JSON array of strings
  placeholder String?
  sortOrder   Int      @default(0)
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

model Suggestion {
  id         String           @id @default(cuid())
  activityId String
  content    String
  authorName String           @default("匿名")
  kind       String           @default("other") // time | place | other
  createdAt  DateTime         @default(now())
  activity   Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  votes      SuggestionVote[]

  @@index([activityId, createdAt])
}

model Participant {
  id              String           @id @default(cuid())
  activityId      String
  clientKey       String
  name            String
  answers         String? // JSON object
  weight          Int              @default(1)
  conditionOptionId String?
  condition       String?
  paid            Boolean          @default(false)
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  activity        Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  votes           Vote[]
  suggestionVotes SuggestionVote[]

  @@unique([activityId, clientKey])
  @@index([activityId, createdAt])
}

model Vote {
  id            String      @id @default(cuid())
  participantId String
  optionId      String
  value         Int         @default(1) // 1 support | -1 veto
  rank          Int         @default(0) // 0 = unranked
  createdAt     DateTime    @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  option        PollOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([participantId, optionId])
  @@index([optionId])
}

model SuggestionVote {
  id            String      @id @default(cuid())
  participantId String
  suggestionId  String
  createdAt     DateTime    @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  suggestion    Suggestion  @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([participantId, suggestionId])
  @@index([suggestionId])
}
