# SQLite for local development. For production, point this at a persistent volume
# or swap the provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Public site URL used by metadata and share links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudflare Turnstile (optional). Leave both empty to skip human verification.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
